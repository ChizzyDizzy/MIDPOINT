# SafeMind Configuration
# Copy this file to .env and add your actual API keys

# ============================================================
# Backend Mode - Choose ONE:
# ============================================================
# Option 1: External Service - RECOMMENDED for best responses
BACKEND_MODE=openai
SERVICE_API_KEY=sk-your-api-key-here
SERVICE_MODEL=gpt-3.5-turbo

# Option 2: Hugging Face API (alternative service)
# BACKEND_MODE=huggingface
# HUGGINGFACE_API_KEY=your_huggingface_key_here
# HUGGINGFACE_MODEL=microsoft/DialoGPT-medium

# Option 3: Local trained model (offline, requires training first)
# BACKEND_MODE=local
# HUGGINGFACE_MODEL=./safemind-trained-model

# Option 4: Template-based responses (no external service needed)
# BACKEND_MODE=fallback

# ============================================================
# Flask Configuration
# ============================================================
FLASK_SECRET_KEY=your_secret_key_here
FLASK_ENV=development
FLASK_DEBUG=True

# ============================================================
# Safety Configuration
# ============================================================
CRISIS_DETECTION_THRESHOLD=0.7
ENABLE_RESPONSES=True

# Cultural Settings
DEFAULT_CULTURE=south_asian
